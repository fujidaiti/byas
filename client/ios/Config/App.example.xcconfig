// Copy to App.xcconfig and adjust. Consumed by ShareExtension.xcconfig,
// surfaced into ShareExtension/Info.plist as APIBaseURL, and read at runtime by
// AppConfig.swift.
//
// This is the iOS counterpart of client/.env, deliberately kept separate: .env
// points at a host-machine alias that means nothing to an iPhone or the iOS
// simulator.

// xcconfig treats // as a comment delimiter anywhere on a line, including inside
// a value, so a URL's slashes have to arrive through a variable. Without this,
// "http://localhost:8080" silently becomes "http:".
APP_URL_SLASH = /

// Base URL of the Paperdoll REST API.
APP_API_BASE_URL = http:$(APP_URL_SLASH)$(APP_URL_SLASH)localhost:8080
