// Base configuration for all three ShareExtension build configurations.
//
// Keep all three of the ShareExtension target's configurations pointed at this
// file — Xcode's project editor > Info > Configurations, or
// baseConfigurationReference in project.pbxproj.

// FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER, from pubspec.yaml.
#include "../Flutter/Generated.xcconfig"
// Generated by ci_scripts/ci_post_clone.sh from version.json; absent locally,
// where Generated.xcconfig's pubspec-derived values apply instead. Runner picks
// up the same two files via Flutter/Debug.xcconfig and Flutter/Release.xcconfig.
#include? "../Flutter/Version.xcconfig"
// PAPERDOLL_API_BASE_URL. Not committed; see App.example.xcconfig.
#include "App.xcconfig"

// An embedded extension's version must match its host app's exactly or App Store
// Connect rejects the upload, so both derive from the same two settings.
// Do NOT set these in the target's build settings: target-level settings override
// a base configuration, silently.
MARKETING_VERSION = $(FLUTTER_BUILD_NAME)
CURRENT_PROJECT_VERSION = $(FLUTTER_BUILD_NUMBER)
